config nfqws2 'general'
	option enabled '1'
	option isp_interface 'eth3'
	option nfqws_mode 'MODE_AUTO'
	option tcp_ports '80,443,1984,2053,2083,2087,2096,5222,8443'
	option udp_ports '443,590:600,1400,3478:3481,5349,19294:19344,49152:65535'
	option ipv6_enabled '1'
	option policy_name 'nfqws'
	option policy_exclude '0'
	option log_level '0'
	option nfqueue_num '300'
	option user 'nobody'

config nfqws2 'strategies'
	option nfqws_base_args '--lua-init=@/etc/nfqws2/lua/zapret-lib.lua\n                 --lua-init=@/etc/nfqws2/lua/zapret-antidpi.lua\n                 --lua-init=@/etc/nfqws2/lua/zapret-auto.lua\n                 --blob=quic_initial:@/etc/nfqws2/blobs/quic_initial.bin\n                 --blob=tls_clienthello:@/etc/nfqws2/blobs/tls_clienthello.bin'
	option nfqws_args '--filter-tcp=443,80,1984,5222 --filter-l7=http,tls,mtproto\n            --payload=tls_client_hello,mtproto_initial\n            --lua-desync=circular:fails=2:time=300:retrans=3:nld=2'
	option nfqws_args_quic '--filter-udp=443 --filter-l7=quic\n                 --payload=quic_initial\n                 --lua-desync=fake:blob=quic_initial:repeats=11'
	option nfqws_args_udp '--filter-udp=590-600,1400,3478-3481,5349,19294-19344,49152-65535\n                --filter-l7=wireguard,stun,discord,mtproto,unknown\n                --out-range=<n2\n                --payload=wireguard_initiation,wireguard_response,wireguard_cookie,stun,discord_ip_discovery,mtproto_initial,unknown\n                --lua-desync=circular:fails=2:time=300:retrans=3:nld=2\n                --lua-desync=fake:repeats=6:strategy=1'
	option nfqws_args_custom ''
	option nfqws_args_ipset '--ipset=/etc/nfqws2/lists/ipset.list --ipset-exclude=/etc/nfqws2/lists/ipset_exclude.list'
