msgid "NFQWS2"
msgstr "NFQWS2"

msgid "Web interface for managing nfqws2 DPI bypass utility. Settings are stored in UCI and auto-generated into nfqws2.conf on service start."
msgstr "Веб-интерфейс для управления утилитой обхода DPI nfqws2. Настройки хранятся в UCI и автоматически генерируются в nfqws2.conf при запуске службы."

msgid "General Settings"
msgstr "Общие настройки"

msgid "Enabled"
msgstr "Включено"

msgid "Enable nfqws2 service"
msgstr "Включить службу nfqws2"

msgid "Network Interface"
msgstr "Сетевой интерфейс"

msgid "Provider network interface, e.g. eth3 or ppp0. Can specify multiple interfaces separated by space."
msgstr "Сетевой интерфейс провайдера, например eth3 или ppp0. Можно указать несколько интерфейсов через пробел."

msgid "TCP Ports"
msgstr "TCP-порты"

msgid "TCP ports for iptables rules. Leave empty to disable TCP processing."
msgstr "TCP-порты для правил iptables. Оставьте пустым, чтобы отключить обработку TCP."

msgid "UDP Ports"
msgstr "UDP-порты"

msgid "UDP ports for iptables rules. Leave empty to disable UDP processing."
msgstr "UDP-порты для правил iptables. Оставьте пустым, чтобы отключить обработку UDP."

msgid "IPv6 Enabled"
msgstr "IPv6 включён"

msgid "Process IPv6 connections"
msgstr "Обрабатывать IPv6-соединения"

msgid "Policy Name"
msgstr "Название политики"

msgid "Keenetic access policy name. Only devices in this policy will be processed."
msgstr "Имя политики доступа Keenetic. Будут обрабатываться только устройства из этой политики."

msgid "Policy Exclude Mode"
msgstr "Политика исключает обработку"

msgid "When enabled, all devices EXCEPT those in the policy will be processed."
msgstr "Если включено, будут обрабатываться все устройства, кроме добавленных в политику."

msgid "NFQueue Number"
msgstr "Номер NFQueue"

msgid "Netfilter NFQUEUE queue number"
msgstr "Номер очереди NFQUEUE в netfilter"

msgid "Run As User"
msgstr "Запускать от имени"

msgid "User to run nfqws2 process as"
msgstr "Пользователь, от имени которого будет запущен процесс nfqws2"

msgid "Debug Logging"
msgstr "Отладочное логирование"

msgid "Enable debug-level syslog logging"
msgstr "Включить логирование отладочного уровня в syslog"

msgid "Working Mode"
msgstr "Режим работы"

msgid "How nfqws2 selects which domains to process"
msgstr "Как nfqws2 определяет, какие домены обрабатывать"

msgid "Auto"
msgstr "Авто"

msgid "Automatically detects blocked resources"
msgstr "Автоматически определяет заблокированные ресурсы"

msgid "List"
msgstr "Список"

msgid "Only processes domains from user.list"
msgstr "Обрабатывает только домены из user.list"

msgid "All"
msgstr "Все"

msgid "Processes all traffic except exclude.list"
msgstr "Обрабатывает весь трафик, кроме доменов из exclude.list"

msgid "Strategies"
msgstr "Стратегии"

msgid "Startup Arguments"
msgstr "Параметры запуска"

msgid "Lua init scripts, blob definitions, and other base arguments"
msgstr "Скрипты инициализации Lua, определения blob и другие базовые параметры"

msgid "Base Strategy (HTTPS/HTTP)"
msgstr "Базовая стратегия (HTTPS/HTTP)"

msgid "Main DPI bypass strategy for HTTPS and HTTP traffic"
msgstr "Основная стратегия обхода DPI для HTTPS и HTTP трафика"

msgid "QUIC Strategy"
msgstr "Стратегия QUIC"

msgid "DPI bypass strategy for QUIC/UDP traffic"
msgstr "Стратегия обхода DPI для QUIC/UDP трафика"

msgid "UDP Strategy"
msgstr "Стратегия UDP"

msgid "Strategy for UDP traffic (WireGuard, STUN, etc.). Does not use domain lists."
msgstr "Стратегия для UDP-трафика (WireGuard, STUN и т.д.). Не использует списки доменов."

msgid "Custom Strategy"
msgstr "Пользовательская стратегия"

msgid "Additional custom strategies. Use --new to separate multiple strategies."
msgstr "Дополнительные пользовательские стратегии. Используйте --new для разделения нескольких стратегий."

msgid "IPSET Arguments"
msgstr "Параметры IPSET"

msgid "IP list paths for include/exclude"
msgstr "Пути к IP-спискам для включения/исключения"

msgid "Domain Lists"
msgstr "Списки доменов"

msgid "Lists"
msgstr "Списки"

msgid "Current file is not saved. Really close?"
msgstr "Текущий файл не сохранён. Действительно закрыть?"

msgid "File saved successfully"
msgstr "Файл успешно сохранён"

msgid "Failed to save file"
msgstr "Не удалось сохранить файл"

msgid "Failed to create file"
msgstr "Не удалось создать файл"

