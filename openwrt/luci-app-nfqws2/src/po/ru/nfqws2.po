msgid "Loading..."
msgstr "Загрузка..."

msgid "Unsaved changes"
msgstr "Несохранённые изменения"

msgid "Log Files"
msgstr "Лог-файлы"

msgid "Logs"
msgstr "Логи"

msgid "Really clear this log file?"
msgstr "Действительно очистить этот лог-файл?"

msgid "Clear Log"
msgstr "Очистить лог"

msgid "Refresh"
msgstr "Обновить"

msgid "Lua Scripts"
msgstr "Lua-скрипты"

msgid "Lua Script Editor"
msgstr "Редактор Lua-скриптов"

msgid "Enter filename (e.g., custom.lua):"
msgstr "Введите имя файла (например, custom.lua):"

msgid "Check complete:"
msgstr "Проверка завершена:"

msgid "Total:"
msgstr "Всего:"

msgid "Available:"
msgstr "Доступно:"

msgid "Blocked:"
msgstr "Заблокировано:"

msgid "Unknown:"
msgstr "Неизвестно:"

msgid "Configuration"
msgstr "Конфигурация"

msgid "Configuration page"
msgstr "Страница конфигурации"

msgid "Running"
msgstr "Работает"

msgid "Stopped"
msgstr "Остановлен"

msgid "Checking..."
msgstr "Проверка..."

msgid "Start"
msgstr "Запустить"

msgid "Stop"
msgstr "Остановить"

