#!/bin/sh /etc/rc.common

USE_PROCD=1
START=51
STOP=49

CFGFILE=/etc/config/nfqws2
CONFGEN=/usr/share/nfqws2/generate_conf.sh
CONFDEST=/etc/nfqws2/nfqws2.conf

start_service() {
	local enabled
	enabled=$(uci get nfqws2.general.enabled 2>/dev/null)
	[ "$enabled" != "1" ] && return

	# Create required directories
	mkdir -p /etc/nfqws2/lists
	mkdir -p /etc/nfqws2/lua
	mkdir -p /var/log

	# Generate nfqws2.conf from UCI
	if [ -x "$CONFGEN" ]; then
		"$CONFGEN"
	fi

	procd_open_instance
	procd_set_param command /usr/bin/nfqws2
	procd_set_param stderr 1
	procd_set_param respawn
	procd_close_instance
}

